#
#: ilovevoley/templates/users/profile.html:366
msgid ""
"<strong>Privacidad:</strong> La URL es única y personal. No la compartas."
msgstr ""
"<strong>Privacitat:</strong> La URL és única i personal. No la comparteixis."

