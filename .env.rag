# Configuración para sistema RAG con Ollama externo
# Copia este archivo a .env y ajusta los valores

# Ollama (tu servidor existente)
OLLAMA_HOST=http://192.168.0.16:11434

# ChromaDB
CHROMA_COLLECTION_NAME=videosvoley_docs
CHROMA_PERSIST_DIR=./chroma_db

# Modelo de embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Modelo por defecto de Ollama (phi3:mini recomendado)
DEFAULT_OLLAMA_MODEL=phi3:mini